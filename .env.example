# Copy this file to .env and fill in real values for local development:
#   cp .env.example .env
#
# .env is gitignored — never commit it, and never commit real secrets in this
# file. In CI or production, set these as real environment variables (or via
# your platform's secret manager) instead of shipping a .env file.

# --- Server ---
PORT=3100
MODEL_CATALOG_PATH=data/model-catalog.json

# Optional Claude connection via Hekate's existing shared CLI provider.
# Native Python and Claude must run on the same OS as Node for tree cancellation.
# HEKATE_CLI_ROOT=D:/Git/Hekate
# HEKATE_CLI_PYTHON=D:/path/to/python.exe
# HEKATE_CLAUDE_EXECUTABLE=D:/path/to/native/claude.exe
# HEKATE_CLI_WORKING_DIRECTORY=D:/path/to/empty-chat-working-directory
# strict blocks until a per-invocation included-only guarantee is supported.
# headroom allows fresh reported usage below 80%; paid overage is still possible.
# HEKATE_CLAUDE_USAGE_POLICY=strict

# --- Provider selection ---
# CHAT_FAST_PROVIDER / CHAT_DEEP_PROVIDER: one of mock | azure | bedrock | ollama
CHAT_FAST_PROVIDER=mock
CHAT_FAST_MODEL=mock-v1
CHAT_FAST_TEMPERATURE=0.2

CHAT_DEEP_PROVIDER=mock
CHAT_DEEP_MODEL=mock-v1
CHAT_DEEP_TEMPERATURE=0.2

# --- Azure OpenAI ---
# Required only if CHAT_FAST_PROVIDER or CHAT_DEEP_PROVIDER is "azure".
# AZURE_OPENAI_API_KEY is a secret. Leave blank here; set the real value only
# in your local .env (untracked) or in your deployment's secret store.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- AWS Bedrock ---
# Required only if CHAT_FAST_PROVIDER or CHAT_DEEP_PROVIDER is "bedrock".
# Region is not a secret. Credentials are NOT read from this app's config at
# all — the AWS SDK resolves them from the standard credential chain
# (aws configure, an IAM role, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY set as
# real environment variables, etc). Do not add AWS access keys to this file.
BEDROCK_REGION=us-east-1

# --- Azure ARM (management-plane) credentials for deployment discovery only ---
# Optional. Separate from AZURE_OPENAI_API_KEY (the data-plane key used for
# actual chat calls) -- listing deployments now requires the ARM management
# plane, not the Azure OpenAI resource endpoint (that listing API was retired
# in 2024). Without these, Azure deployment discovery is simply unavailable;
# the server still starts and everything else still works.
AZURE_ARM_TENANT_ID=
AZURE_ARM_CLIENT_ID=
AZURE_ARM_CLIENT_SECRET=
AZURE_ARM_SUBSCRIPTION_ID=
AZURE_ARM_RESOURCE_GROUP=
AZURE_ARM_ACCOUNT_NAME=

# --- Ollama (local model runtime, no secret) ---
OLLAMA_BASE_URL=http://localhost:11434
# Increase these on slower hardware/models to avoid provider timeouts.
OLLAMA_FAST_TIMEOUT_MS=20000
OLLAMA_DEEP_TIMEOUT_MS=60000
# off/on/default; explicit controls require /api/version + /api/show thinking.values.
# If the runtime cannot verify a control, startup fails. default sends no think field.
OLLAMA_FAST_THINK=off
OLLAMA_DEEP_THINK=default
# Increase these for models that emit long thinking traces before final text.
OLLAMA_FAST_NUM_PREDICT=256
OLLAMA_DEEP_NUM_PREDICT=512

# --- Conversation context budget (spec 01) ---
# 8192 is an application working limit for this prototype, not a statement of any
# particular model's real context window.
# Selected catalog limits.contextTokens can further lower this window.
CONTEXT_WINDOW_TOKENS=8192
CONTEXT_MAX_HISTORY_TURNS=12
CONTEXT_SAFETY_TOKENS=256
# Internal summaries: off / extractive / model. Extractive makes no model calls.
CONTEXT_SUMMARY_MODE=extractive
CONTEXT_SUMMARY_TRIGGER_RATIO=0.8
CONTEXT_SUMMARY_MAX_TOKENS=1024
CONTEXT_SUMMARY_TIMEOUT_MS=5000
# Model mode only: explicitly opt in to additional calls using the configured fast
# provider/model, with a separate summary output cap. Never defaults to deep.
# CONTEXT_SUMMARY_MODEL_BINDING=fast
# Output reserves; also used as the Ollama num_predict default when
# OLLAMA_FAST_NUM_PREDICT / OLLAMA_DEEP_NUM_PREDICT are not explicitly set.
# For an Ollama role, an explicit override is also its context output reserve.
# Overrides must be positive integers; startup rejects reserves that leave no input.
CHAT_FAST_MAX_OUTPUT_TOKENS=512
CHAT_DEEP_MAX_OUTPUT_TOKENS=2048

# --- Model discovery / inventory (spec 03) ---
# Refresh cadence for provider connection discovery (Ollama installed models,
# Azure ARM deployments, Bedrock foundation models). TTL controls how long an
# observation stays "ready" before it becomes "stale"; a failed refresh never
# extends an existing observation's expiry.
MODEL_DISCOVERY_INTERVAL_MS=300000
MODEL_DISCOVERY_TTL_MS=600000
MODEL_DISCOVERY_TIMEOUT_MS=10000

# --- Declared execution/billing facts per default connection (spec 03 / resource policy) ---
# These are DECLARED policy facts, never inferred from a base URL or provider
# name -- a localhost Ollama URL does not by itself mean "local-device", and a
# provider name never implies a billing model. Leave unset for "unknown".
# Scope: local-device | self-hosted-remote | managed-cloud | hybrid | unknown
# Billing components (comma-separated): metered-usage, subscription,
# provisioned-capacity, owned-compute, unknown
# OLLAMA_EXECUTION_SCOPE=local-device
# OLLAMA_BILLING_COMPONENTS=owned-compute
# OLLAMA_PROCESSING_REGION=
# AZURE_EXECUTION_SCOPE=managed-cloud
# AZURE_BILLING_COMPONENTS=metered-usage
# AZURE_PROCESSING_REGION=
# BEDROCK_EXECUTION_SCOPE=managed-cloud
# BEDROCK_BILLING_COMPONENTS=metered-usage
# BEDROCK_PROCESSING_REGION=

# --- Adaptive routing / telemetry persistence ---
ROUTING_MAX_FAST_P95_MS=1000
TELEMETRY_STORE_PATH=data/latency-telemetry.json
TELEMETRY_SAVE_INTERVAL_MS=5000
DEEP_WORKER_AUTO_RUN=true
DEEP_WORKER_INTERVAL_MS=500

# --- Benchmark runner (optional; usually passed inline per command instead) ---
# BENCH_MODE=simulate
# BENCH_SIM_SEED=default-v1
# Live uses automatic workers and separate reports/live-benchmark-v2.{json,md} defaults.
# BENCH_DEADLINE_MS=120000
# BENCH_BASE_URL=http://localhost:3100
# BENCH_PROMPTS_PATH=data/benchmark-prompts.json
# BENCH_JSON_OUT=reports/benchmark-summary.json
# BENCH_MD_OUT=reports/benchmark-summary.md

# --- Benchmark comparison gates (optional) ---
# BENCH_BASELINE_PATH=reports/benchmark-summary-baseline.json
# BENCH_CANDIDATE_PATH=reports/benchmark-summary.json
# BENCH_COMPARE_OUT=reports/benchmark-compare.md
# BENCH_MAX_FIRST_P95_REGRESSION_MS=150
# BENCH_MAX_FINAL_P95_REGRESSION_MS=300
# BENCH_MAX_DEAD_LETTER_REGRESSION=0.05
# BENCH_MIN_QUALITY_DELTA=-0.05

# --- Evaluation report gates (optional) ---
# EVAL_INPUT_PATH=data/eval-records.json
# EVAL_OUTPUT_PATH=reports/prototype-eval.md
# EVAL_MAX_AVG_LATENCY_MS=1000
# EVAL_MIN_AVG_SCORE=4
# EVAL_MIN_CITATION_RATE=0.9
# EVAL_MAX_DEAD_LETTER_RATE_DEEP=0.1
# EVAL_MAX_AVG_RETRIES_DEEP=1

# --- Optional local documentation tasks (disabled when Python path is empty) ---
# Use a Python environment with experiments/doc-agent/requirements-durable.txt.
# For Windows Node, use a Windows Python executable; for Linux Node, use Linux Python.
DOC_TASK_PYTHON=
DOC_TASK_ROOT=data/document-tasks
DOC_TASK_MODEL=gemma4:26b

# --- Task-based dispatch (spec 04; opt-in) ---
# fixed preserves the configured fast/deep pair. catalog requires fresh discovery,
# curated context/output limits and explicit per-binding resource evidence.
MODEL_ROUTING_MODE=fixed
# MODEL_DISPATCH_CONFIG_PATH=data/dispatch-policy.local.json
# Policy schema/example: docs/implementation/04-dispatch.md#configuration
# Catalog routingPriority defaults to 100 (lower wins). Evaluation environment
# must match "<connectionId>:<policy.environment>". No provider is provisioned.

# Graceful runtime shutdown (milliseconds). Timeout must exceed grace.
SHUTDOWN_GRACE_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Passive evaluation capture (no added inference/tool calls).
EVAL_RECORDING=false
EVAL_DATASET_PATH=data/evaluation-dataset.example.json
EVAL_CAPTURE=metadata
EVAL_OUTPUT_ROOT=reports/evaluations
EVAL_MAX_BYTES=10485760
EVAL_MAX_EVENTS=10000
EVAL_RETENTION_MS=604800000
EVAL_REPETITION=1
EVAL_CONDITION=unknown

# Optional BALLDONTLIE games adapter. No account/trial is created automatically.
# Used only by explicit sports:games runs; never put this key in a briefing profile.
BALLDONTLIE_API_KEY=
