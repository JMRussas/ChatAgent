# Copy this file to .env and fill in real values for local development:
#   cp .env.example .env
#
# .env is gitignored — never commit it, and never commit real secrets in this
# file. In CI or production, set these as real environment variables (or via
# your platform's secret manager) instead of shipping a .env file.

# --- Server ---
PORT=3100

# --- Provider selection ---
# CHAT_FAST_PROVIDER / CHAT_DEEP_PROVIDER: one of mock | azure | bedrock | ollama
CHAT_FAST_PROVIDER=mock
CHAT_FAST_MODEL=mock-v1
CHAT_FAST_TEMPERATURE=0.2

CHAT_DEEP_PROVIDER=mock
CHAT_DEEP_MODEL=mock-v1
CHAT_DEEP_TEMPERATURE=0.2

# --- Azure OpenAI ---
# Required only if CHAT_FAST_PROVIDER or CHAT_DEEP_PROVIDER is "azure".
# AZURE_OPENAI_API_KEY is a secret. Leave blank here; set the real value only
# in your local .env (untracked) or in your deployment's secret store.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- AWS Bedrock ---
# Required only if CHAT_FAST_PROVIDER or CHAT_DEEP_PROVIDER is "bedrock".
# Region is not a secret. Credentials are NOT read from this app's config at
# all — the AWS SDK resolves them from the standard credential chain
# (aws configure, an IAM role, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY set as
# real environment variables, etc). Do not add AWS access keys to this file.
BEDROCK_REGION=us-east-1

# --- Ollama (local model runtime, no secret) ---
OLLAMA_BASE_URL=http://localhost:11434
# Increase these on slower hardware/models to avoid provider timeouts.
OLLAMA_FAST_TIMEOUT_MS=20000
OLLAMA_DEEP_TIMEOUT_MS=60000
# Increase these for models that emit long thinking traces before final text.
OLLAMA_FAST_NUM_PREDICT=256
OLLAMA_DEEP_NUM_PREDICT=512

# --- Adaptive routing / telemetry persistence ---
ROUTING_MAX_FAST_P95_MS=1000
TELEMETRY_STORE_PATH=data/latency-telemetry.json
TELEMETRY_SAVE_INTERVAL_MS=5000
DEEP_WORKER_AUTO_RUN=true
DEEP_WORKER_INTERVAL_MS=500

# --- Benchmark runner (optional; usually passed inline per command instead) ---
# BENCH_MODE=simulate
# BENCH_SIM_SEED=default-v1
# BENCH_BASE_URL=http://localhost:3100
# BENCH_PROMPTS_PATH=data/benchmark-prompts.json
# BENCH_JSON_OUT=reports/benchmark-summary.json
# BENCH_MD_OUT=reports/benchmark-summary.md

# --- Benchmark comparison gates (optional) ---
# BENCH_BASELINE_PATH=reports/benchmark-summary-baseline.json
# BENCH_CANDIDATE_PATH=reports/benchmark-summary.json
# BENCH_COMPARE_OUT=reports/benchmark-compare.md
# BENCH_MAX_FIRST_P95_REGRESSION_MS=150
# BENCH_MAX_FINAL_P95_REGRESSION_MS=300
# BENCH_MAX_DEAD_LETTER_REGRESSION=0.05
# BENCH_MIN_QUALITY_DELTA=-0.05

# --- Evaluation report gates (optional) ---
# EVAL_INPUT_PATH=data/eval-records.json
# EVAL_OUTPUT_PATH=reports/prototype-eval.md
# EVAL_MAX_AVG_LATENCY_MS=1000
# EVAL_MIN_AVG_SCORE=4
# EVAL_MIN_CITATION_RATE=0.9
# EVAL_MAX_DEAD_LETTER_RATE_DEEP=0.1
# EVAL_MAX_AVG_RETRIES_DEEP=1
